{
  "name": "shekarestan-app",
  "compatibility_date": "2026-08-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shekarestan-db",
      "database_id": "5ffeccaf-5b64-4dfe-9f3b-2dea11ccfafa"
    }
  ]
}
